# Copie para .env e preencha com os valores reais (nunca commitar o .env).
#
# Postgres do Supabase (Project Settings > Database > Connect > ORM > Prisma).
# DATABASE_URL usa o pooler (pgbouncer, porta 6543) para queries da app.
# DIRECT_URL usa a porta 5432 (sem pooler), necessária pro Prisma Migrate.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Segredo usado para assinar a sessão do painel (troque por um valor aleatório forte).
SESSION_SECRET="troque-este-segredo-antes-de-ir-para-producao"

# Usados pelo script de seed (npm run db:seed) pra criar o primeiro usuário admin.
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"
ADMIN_NAME="Admin"
